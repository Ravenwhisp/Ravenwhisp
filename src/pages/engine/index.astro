---
import Layout from '@/layouts/Layout.astro'

const pageTitle = 'Engine | Bound By Death'
const pageDescription = 'Here you can see how our custom engine has been created, check the images and videos to see more indepth how it looks like.'
---

<Layout title={pageTitle} description={pageDescription}>
  <section class='py-16 sm:py-24'>
    <div class='mx-auto max-w-4xl space-y-6 px-4 sm:px-6 lg:px-8'>
      <h1 class='text-foreground text-4xl font-bold'>Engine</h1>
      <p class='text-muted-foreground text-lg'>
        Our engine is not finish yet, once we have it done you will be able to see all its beauty in display!
      </p>
      <p class='text-muted-foreground'>Follow Ravenwhisp Studio channels for release and playtest announcements.</p>
    </div>
  </section>
</Layout>
