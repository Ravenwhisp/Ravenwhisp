---
import Layout from '@/layouts/Layout.astro'
import BlogYouTube from '@/components/blog-media/blog-youtube.astro'
import { getCollection } from 'astro:content'
import { ENGINE_MODULE_GROUPS } from '@/utils/engine-module-groups'
import { getEngineModuleImages } from '@/utils/engine-module-images'
import { withBasePath } from '@/lib/paths'

const pageTitle = 'Engine | Bound By Death'
const pageDescription =
  "Explore RavEngine — Ravenwhisp Studios' modular DirectX 12 engine and editor built for Bound By Death."
const topics = await getCollection('engine')
const sortedTopics = topics.sort((a, b) => a.data.sortOrder - b.data.sortOrder)

const groupedTopics = ENGINE_MODULE_GROUPS.map(group => ({
  ...group,
  modules: sortedTopics.filter(topic => topic.data.moduleGroup === group.id)
})).filter(group => group.modules.length > 0)
---

<Layout title={pageTitle} description={pageDescription}>
  <section class='py-16 sm:py-24'>
    <div class='mx-auto max-w-7xl space-y-12 px-4 sm:px-6 lg:px-8'>
      <div class='space-y-6'>
        <p class='text-primary text-sm font-semibold tracking-widest uppercase'>Built From the Ground Up</p>
        <h1 class='text-foreground text-4xl font-bold'>RavEngine</h1>
        <p class='text-muted-foreground text-lg leading-relaxed'>
          <strong class='text-foreground'>RavEngine</strong> is our custom Windows-native game engine and editor, built around a modular
          <strong class='text-foreground'>Application</strong> class. Each subsystem inherits from
          <code class='text-foreground bg-muted rounded px-1.5 py-0.5 text-sm'>Module</code>,
          following a shared lifecycle that handles initialization, updates, pre-rendering, rendering, post-rendering, and shutdown.
          This process is managed by a classic Win32 main loop, where each
          <strong class='text-foreground'>WM_PAINT</strong> message triggers a complete frame.
        </p>

        <p class='text-muted-foreground text-lg leading-relaxed'>
          The engine uses <strong class='text-foreground'>DirectX 12</strong> for rendering and a component-based scene graph
          to manage gameplay and editor data. Its editor build features dockable
          <strong class='text-foreground'>ImGui</strong> windows and scene viewports, while the
          <strong class='text-foreground'>GAME_RELEASE</strong> build loads scenes and audio through
          <code class='text-foreground bg-muted rounded px-1.5 py-0.5 text-sm'>build.cfg</code>,
          rendering directly to the swap chain.
        </p>
        <div class='mx-auto w-full max-w-3xl'>
          <BlogYouTube
            url='https://youtu.be/T8rWmCnGA00'
            title='Engine trailer — Ravenwhisp Studios custom engine'
            caption='Official RavEngine trailer'
          />
        </div>
      </div>

      {
        groupedTopics.map(group => (
          <div class='space-y-5'>
            <div class='space-y-2'>
              <h2 class='text-foreground text-2xl font-semibold'>{group.title}</h2>
              <p class='text-muted-foreground text-sm'>
                Explore the modules that make up this layer of the engine.
              </p>
            </div>
            <div class='grid gap-5 sm:grid-cols-2'>
              {group.modules.map(topic => {
                const moduleImages = getEngineModuleImages(topic.data.slug)
                const cardImageUrl =
                  topic.data.imageUrl?.trim() || moduleImages?.imageUrl?.trim() || undefined
                const cardImageAlt = topic.data.imageAlt ?? moduleImages?.imageAlt ?? topic.data.title

                return (
                <a
                  href={withBasePath(`/engine/${topic.data.slug}`)}
                  class='group border-border bg-card hover:bg-muted/30 flex min-h-36 flex-col gap-4 border p-4 transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none sm:flex-row sm:items-stretch'
                >
                  {cardImageUrl && (
                  <div class='sm:w-28 sm:shrink-0'>
                      <img
                        src={withBasePath(cardImageUrl)}
                        alt={cardImageAlt}
                        class='size-full max-h-28 min-h-24 object-cover sm:max-h-none sm:min-h-28'
                        loading='lazy'
                      />
                  </div>
                  )}
                  <span class='min-w-0 space-y-2'>
                    <span class='text-foreground block text-lg font-semibold group-hover:underline'>
                      {topic.data.title}
                    </span>
                    <span class='text-muted-foreground block text-sm leading-relaxed'>{topic.data.description}</span>
                  </span>
                </a>
                )
              })}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
