---
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { withBasePath } from '@/lib/paths'

const pageTitle = 'Engine | Bound By Death'
const pageDescription = "Explore the systems and tools behind Ravenwhisp Studios' custom game engine."
const topics = await getCollection('engine')
const sortedTopics = topics.sort((a, b) => a.data.title.localeCompare(b.data.title))
---

<Layout title={pageTitle} description={pageDescription}>
  <section class='py-16 sm:py-24'>
    <div class='mx-auto max-w-5xl space-y-8 px-4 sm:px-6 lg:px-8'>
      <h1 class='text-foreground text-4xl font-bold'>Engine</h1>
      <p class='text-muted-foreground text-lg'>
        We have created our own CUSTOM ENGINE using DirectX12, Visual Studio and libraries. Here are all the parts that made our engine:
      </p>

      <div class='grid gap-5 sm:grid-cols-2'>
        {sortedTopics.map(topic => (
          <a
            href={withBasePath(`/engine/${topic.data.slug}`)}
            class='group border-border bg-card flex min-h-36 items-center gap-5 border p-4 transition-colors hover:bg-muted/30 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none'
          >
            <img
              src={withBasePath(topic.data.imageUrl)}
              alt={topic.data.imageAlt}
              class='size-24 shrink-0 object-cover sm:size-28'
              loading='lazy'
            />
            <span class='min-w-0 space-y-2'>
              <span class='text-foreground block text-lg font-semibold group-hover:underline'>{topic.data.title}</span>
              <span class='text-muted-foreground block text-sm'>{topic.data.description}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
