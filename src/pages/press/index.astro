---
import Layout from '@/layouts/Layout.astro'
import { getPressKitAssets } from '@/utils/presskit'
import { withBasePath } from '@/lib/paths'
import { ExternalLinkIcon } from 'lucide-react'

const pageTitle = 'Press | Ravenwhisp Studio'
const pageDescription = 'Press kit and media resources for Ravenwhisp Studio.'

const logoPackAssets = getPressKitAssets('logo-pack')
const keyartAssets = getPressKitAssets('key-art')
const screenshotsAssets = getPressKitAssets('screenshots')
const studioShotsAssets = getPressKitAssets('studio-shots')

const pressKitItems = [
  {
    title: 'Logo Pack',
    image: withBasePath(logoPackAssets[0]?.src || '/images/placeholder.png'),
    href: '/press/press-kit/logo-pack',
    alt: 'Ravenwhisp logo pack preview',
  },
  {
    title: 'Key Art',
    image: withBasePath(keyartAssets[0]?.src || '/images/placeholder.png'),
    alt: 'Key art preview',
  },
  {
    title: 'Screenshots',
    image: withBasePath(screenshotsAssets[0]?.src || '/images/placeholder.png'),
    alt: 'Game screenshots',
  },
  {
    title: 'Studio Shots',
    image: withBasePath(studioShotsAssets[0]?.src || '/images/placeholder.png'),
    alt: 'Studio photos',
  },
]

