---
import Layout from '@/layouts/Layout.astro'

const pageTitle = 'Engine | Bound By Death'
const pageDescription = 'Here you can see how our custom engine has been created, check the images and videos to see more indepth how it looks like.'
---

<Layout title={pageTitle} description={pageDescription}>
  <section class='py-16 sm:py-24'>
    <div class='mx-auto max-w-4xl space-y-6 px-4 sm:px-6 lg:px-8'>
      <h1 class='text-foreground text-4xl font-bold'>Press</h1>
      <p class='text-muted-foreground text-lg'>
        Here you can find all the stuff needed for the Press!
      </p>
      <p class='Pleas dont gorget to check it!.</p>
    </div>
  </section>
</Layout>

const pressKitItems = [
  {
    title: 'Logo Pack',
    image: withBasePath(logoPackAssets[0]?.src || '/images/placeholder.png'),
    href: '/contact/press-kit/logo-pack',
    alt: 'Ravenwhisp logo pack preview'
  },
  {
    title: 'Key Art',
    image: withBasePath(keyartAssets[0]?.src || '/images/placeholder.png'),
    alt: 'Key art placeholder'
  },
  {
    title: 'Screenshots',
    image: withBasePath(screenshotsAssets[0]?.src || '/images/placeholder.png'),
    alt: 'Screenshots placeholder'
  },
  {
    title: 'Studio Shots',
    image: withBasePath(studioShotsAssets[0]?.src || '/images/placeholder.png'),
    alt: 'Studio shots placeholder'
  }
]
