---
import Layout from '@/layouts/Layout.astro'
import { DownloadIcon } from 'lucide-react'
import { getPressKitAssets } from '@/utils/presskit'
import { withBasePath } from '@/lib/paths'

const pageTitle = 'Key Art | Press Kit | Ravenwhisp Studios'
const pageDescription = 'Official press materials and visual assets from Ravenwhisp Studios. Explore our brand identity, game artwork, screenshots, and promotional materials, available for press, media, and partner use.'
const keyArtAssets = getPressKitAssets('logo-pack')

const getPreviewClass = (fileName: string) => {
  if (fileName.includes('Light') || fileName.includes('Transparent_Black')) return 'bg-[#d9ddd8]'
  if (fileName.includes('Dark')) return 'bg-[#1d1f24]'
  return 'bg-black'
}
---

<Layout title={pageTitle} description={pageDescription}>
  <section class='py-12 sm:py-16'>
    <div class='mx-auto max-w-5xl space-y-8 px-4 sm:px-6 lg:px-8'>
      <div class='space-y-3'>
        <div class='flex'>
          <a href={withBasePath('/press')} class='text-muted-foreground text-sm hover:underline'>← Press Kit</a>
        </div>
        <h1 class='text-foreground text-4xl font-bold'>Visual Identity Briefing</h1>
        <p class='text-muted-foreground max-w-3xl text-lg'>
          A visual collection showcasing Bound By Death, Ravenwhisp Studios’ original game project. This selection features key artwork, in-game screenshots, gameplay moments, menu interfaces, and visuals from the underlying game engine.
          Together, these materials offer a glimpse into the game's atmosphere, visual direction, interface design, and technical development.
        </p>
        <p class='text-muted-foreground max-w-3xl text-lg'>
        The assets are provided for press, media coverage, and promotional purposes, offering a closer look at both the player-facing experience and the technology behind the project.
        </p>
      </div>

      <div class='space-y-8'>
        {
          briefingAssets.map(asset => (
            <article class='bg-card border-border overflow-hidden rounded-xl border'>
              <div class='relative flex min-h-48 flex-col justify-center bg-[#1d1f24] sm:min-h-64'>
                <img
                  src={withBasePath(asset.src)}
                  alt={asset.alt}
                  class='h-full w-full object-contain'
                  loading='lazy'
                />
                <a
                  class='absolute right-4 bottom-4 rounded-full shadow-lg'
                  href={withBasePath(asset.src)}
                  download={asset.fileName}
                  aria-label={`Download ${asset.title}`}
                >
                  <DownloadIcon className='size-6' />
                </a>
              </div>

              <div class='flex items-center justify-between px-4 py-3'>
                <div>
                  <h2 class='text-foreground font-medium'>{asset.title}</h2>
                  <p class='text-muted-foreground text-sm'>{asset.fileName}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
