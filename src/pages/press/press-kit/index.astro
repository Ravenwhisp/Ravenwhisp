---
import Layout from '@/layouts/Layout.astro'
import { buttonVariants } from '@/components/ui/button'
import { DownloadIcon } from 'lucide-react'
import { getPressKitAssets } from '@/utils/presskit'
import { withBasePath } from '@/lib/paths'

const pageTitle = 'Logo Pack | Press Kit | Ravenwhisp Studios'
const pageDescription = 'Download official Ravenwhisp Studios logo assets for press, media, and creator use.'
const logoPackAssets = getPressKitAssets('logo-pack')

const getPreviewClass = (fileName: string) => {
  if (fileName.includes('Light') || fileName.includes('Transparent_Black')) return 'bg-[#d9ddd8]'
  if (fileName.includes('Dark')) return 'bg-[#1d1f24]'
  return 'bg-black'
}
---

<Layout title={pageTitle} description={pageDescription}>
  <section class='bg-background border-b' aria-labelledby='logo-pack-title'>
    <div class='mx-auto max-w-7xl px-4 py-8 sm:px-6 md:py-10 lg:px-8'>
      <div class='max-w-4xl space-y-4'>
        <a href={withBasePath('/press')} class='text-muted-foreground text-sm hover:underline'>← Press Kit</a>
        <p class='text-primary text-sm font-semibold tracking-widest uppercase'>Ravenwhisp Studios</p>
        <h1 id='logo-pack-title' class='text-foreground text-4xl font-bold tracking-tight text-balance sm:text-5xl'>
          Logo Pack
        </h1>
        <p class='text-muted-foreground max-w-3xl text-lg leading-relaxed'>
          Official Ravenwhisp Studios logo files for press, partners, and content creators.
        </p>
      </div>
    </div>
  </section>

  <section class='pt-8 pb-16 sm:pt-12 sm:pb-24' aria-label='Logo downloads'>
    <div class='mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8'>
      <div class='grid gap-6 sm:grid-cols-2 lg:grid-cols-3'>
        {
          logoPackAssets.map(asset => (
            <article class='bg-card border-primary/30 overflow-hidden rounded-xl border shadow-lg'>
              <div class={`relative flex min-h-72 flex-col justify-center ${getPreviewClass(asset.fileName)}`}>
                <img
                  src={withBasePath(asset.src)}
                  alt={asset.alt}
                  class='h-full w-full object-contain'
                  loading='lazy'
                />
                <a
                  class={`${buttonVariants({ variant: 'outline', size: 'icon' })} absolute right-4 bottom-4 rounded-full shadow-lg`}
                  href={withBasePath(asset.src)}
                  download={asset.fileName}
                  aria-label={`Download ${asset.title}`}
                >
                  <DownloadIcon className='size-6' />
                </a>
              </div>

              <div class='flex items-center justify-between px-4 py-3'>
                <div>
                  <h2 class='text-foreground font-medium'>{asset.title}</h2>
                  <p class='text-muted-foreground text-sm'>{asset.fileName}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
