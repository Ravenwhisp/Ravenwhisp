---
import Layout from '@/layouts/Layout.astro'
import { getCollection, render } from 'astro:content'
import { withBasePath } from '@/lib/paths'
import { sortPostsByPubDate } from '@/utils/blog'
import { BlogGrid } from '@/components/blocks/blog-component/blog-component'

export async function getStaticPaths() {
  const people = await getCollection('people')
  const team = people.filter(person => person.data.type === 'team' && person.data.bio?.trim())

  return team.map(person => ({
    params: { slug: person.id },
    props: { person }
  }))
}

const { person } = Astro.props
const { Content } = await render(person)

// Get all blog posts by this person
const allPosts = await getCollection('blog')
const allPeople = await getCollection('people')
const visiblePosts = allPosts.filter(post => post.data.visible !== false)

const peopleById = new Map(allPeople.map(p => [p.id, p]))
const getAuthorId = (author: { id: string } | string) => (typeof author === 'string' ? author : author.id)
const getPostAuthorIds = (post: {
  data: { author?: { id: string } | string; authors?: Array<{ id: string } | string> }
}) => {
  if (post.data.authors?.length) {
    return post.data.authors.map(getAuthorId)
  }
  return post.data.author ? [getAuthorId(post.data.author)] : []
}

const getCategories = (post: { data: { category?: string; categories?: string[] } }): string[] => {
  if (post.data.categories?.length) return post.data.categories
  if (post.data.category) return [post.data.category]
  return ['General']
}

// Filter posts by this person
const personPosts = visiblePosts.filter(post => {
  const postAuthorIds = getPostAuthorIds(post)
  return postAuthorIds.includes(person.id)
})

// Format posts for blog component
const formattedPosts = personPosts.map((post, index) => {
  const authorIds = getPostAuthorIds(post)
  const authorNames = authorIds
    .map(authorId => peopleById.get(authorId)?.data.name)
    .filter((name): name is string => Boolean(name))
  const primaryAuthorId = authorIds[0]
  const primaryAuthor = primaryAuthorId ? peopleById.get(primaryAuthorId) : undefined
  const categories = getCategories(post)

  return {
    id: post.data.id || index + 1,
    slug: post.data.slug || post.id,
    title: post.data.title,
    description: post.data.description,
    imageUrl: post.data.imageUrl || '/images/blog-post/post-1.webp',
    imageAlt: post.data.imageAlt || post.data.title,
    pubDate: post.data.pubDate,
    categories: categories,
    author: authorNames.length > 0 ? authorNames.join(', ') : 'Unknown Author',
    avatarFullUrl:
      primaryAuthor?.data.avatarFullUrl ||
      primaryAuthor?.data.avatarTransparentUrl ||
      '/images/avatars/avatar-placeholder.jpg',
    authorUrl:
      authorIds.length === 1 && primaryAuthor?.data.type === 'team' ? `/about-us/team/${primaryAuthorId}` : undefined,
    featured: post.data.featured || false
  }
})

const pageTitle = `${person.data.name} | Team | Ravenwhisp Studio`
const pageDescription = person.data.bio ?? `${person.data.name} profile at Ravenwhisp Studio`

// Sort by date (newest first), then by id (highest first) for ties.
const sortedPersonPosts = sortPostsByPubDate(formattedPosts)
---

<Layout title={pageTitle} description={pageDescription}>
  <section class='space-y-4 py-16 sm:py-24'>
    <div class='mx-auto max-w-4xl space-y-6 px-4 sm:px-6 lg:px-8'>
      <div class='flex'>
        <a href={withBasePath('/about-us')} class='text-muted-foreground text-sm hover:underline'>← Back to About Us</a>
      </div>

      <div class='flex items-start gap-5'>
        <img
          src={withBasePath(
            person.data.avatarFullUrl ?? person.data.avatarTransparentUrl ?? '/images/avatars/avatar-placeholder.jpg'
          )}
          alt={person.data.name}
          class='h-48 w-48 rounded-xl object-cover sm:h-56 sm:w-56'
        />
        <div class='flex-1 space-y-3'>
          <h1 class='text-foreground text-4xl font-bold'>{person.data.name}</h1>
          <p class='text-muted-foreground text-lg'>{person.data.bio}</p>
          {
            (person.data.portfolio || person.data.linkedin) && (
              <div class='flex gap-4 pt-2'>
                {person.data.portfolio && (
                  <a
                    href={person.data.portfolio}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='text-foreground/80 hover:text-foreground inline-flex size-9 items-center justify-center rounded-md transition-colors'
                    aria-label={`Open ${person.data.name} portfolio`}
                  >
                    <svg
                      viewBox='0 0 24 24'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='2'
                      class='size-5'
                      aria-hidden='true'
                    >
                      <rect x='3' y='7' width='18' height='13' rx='2' />
                      <path d='M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2' />
                    </svg>
                  </a>
                )}
                {person.data.linkedin && (
                  <a
                    href={
                      person.data.linkedin.startsWith('http') ? person.data.linkedin : `https://${person.data.linkedin}`
                    }
                    target='_blank'
                    rel='noopener noreferrer'
                    class='text-foreground/80 hover:text-foreground inline-flex size-9 items-center justify-center rounded-md transition-colors'
                    aria-label={`Open ${person.data.name} LinkedIn`}
                  >
                    <svg viewBox='0 0 24 24' fill='currentColor' class='size-5' aria-hidden='true'>
                      <path d='M6.94 8.5A1.56 1.56 0 1 1 6.94 5.4a1.56 1.56 0 0 1 0 3.1zM5.5 9.75h2.88V18H5.5V9.75zM10.1 9.75h2.76v1.12h.04c.38-.72 1.33-1.48 2.74-1.48 2.93 0 3.47 1.93 3.47 4.44V18h-2.88v-3.7c0-.88-.02-2.01-1.22-2.01-1.22 0-1.4.95-1.4 1.95V18H10.1V9.75z' />
                    </svg>
                  </a>
                )}
              </div>
            )
          }
        </div>
      </div>

      <article class='prose dark:prose-invert max-w-none'>
        <Content />
      </article>
    </div>
    {
      sortedPersonPosts.length > 0 && (
        <div class='mx-auto max-w-4xl space-y-6 px-4 sm:px-6 lg:px-8'>
          <div class='space-y-2'>
            <h2 class='text-foreground text-3xl font-semibold'>Blog Posts by {person.data.name}</h2>
            <p class='text-muted-foreground'>Articles and devlogs written by this team member.</p>
          </div>
          <div class='py-8 sm:pb-16 lg:pb-24'>
            <BlogGrid posts={sortedPersonPosts} columnsMaxTwo />
          </div>
        </div>
      )
    }
  </section>
</Layout>
