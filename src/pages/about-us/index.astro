---
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { withBasePath } from '@/lib/paths'

const people = await getCollection('people')
const team = people.filter(person => person.data.type === 'team' && person.data.bio?.trim())
const sortedTeam = team.sort((a, b) => a.data.name.localeCompare(b.data.name))

const pageTitle = 'About Us | Ravenwhisp Studio'
const pageDescription = 'Learn more about Ravenwhisp Studio and our mission behind Bound By Death.'
---

<Layout title={pageTitle} description={pageDescription}>
  <section class='py-16 sm:py-24'>
    <div class='mx-auto max-w-4xl space-y-8 px-4 sm:px-6 lg:px-8'>
      <h1 class='text-foreground text-4xl font-bold'>About Us</h1>
      <p class='text-muted-foreground text-lg'>
        Ravenwhisp Studio is an indie game studio formed within the UPC School (Universitat Politècnica de Catalunya).
      </p>
      <p class='text-muted-foreground'>
        We are currently building <strong class='text-foreground'>Bound By Death</strong>, a dark fantasy co-op
        hack-and-slash for two players.
      </p>

      <div class='space-y-4 pt-6'>
        <h2 class='text-foreground text-2xl font-semibold'>Team</h2>
        <div class='grid gap-6 sm:grid-cols-2'>
          {
            sortedTeam.map(person => (
              <div class='group space-y-3 pt-16'>
                <div class='border-border bg-card hover:bg-muted/30 relative flex scale-[0.98] gap-x-2 border p-4 saturate-[.4] transition-all duration-300 group-hover:scale-100 group-hover:saturate-100'>
                  <a href={withBasePath(`/about-us/team/${person.id}`)} class='absolute bottom-0 left-0 block'>
                    <img
                      src={withBasePath(
                        person.data.avatarTransparentUrl ||
                          person.data.avatarFullUrl ||
                          '/images/avatars/avatar-placeholder.jpg'
                      )}
                      alt={person.data.name}
                      class='h-36 w-36 object-cover'
                    />
                  </a>

                  <div class='flex flex-col justify-between gap-3 pl-36'>
                    <a href={withBasePath(`/about-us/team/${person.id}`)} class='block flex-1'>
                      <h3 class='text-foreground text-lg leading-tight font-semibold'>{person.data.name}</h3>
                    </a>

                    {(person.data.portfolio || person.data.linkedin) && (
                      <div class='flex items-center gap-1'>
                        {person.data.portfolio && (
                          <a
                            href={person.data.portfolio}
                            target='_blank'
                            rel='noopener noreferrer'
                            class='text-foreground/80 hover:text-foreground hover:border-foreground/80 inline-flex size-8 items-center justify-center rounded-lg border-transparent transition-colors hover:border-2'
                            aria-label={`Open ${person.data.name} portfolio`}
                          >
                            <svg
                              viewBox='0 0 24 24'
                              fill='none'
                              stroke='currentColor'
                              stroke-width='2'
                              class='size-5'
                              aria-hidden='true'
                            >
                              <rect x='3' y='7' width='18' height='13' rx='2' />
                              <path d='M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2' />
                            </svg>
                          </a>
                        )}
                        {person.data.linkedin && (
                          <a
                            href={
                              person.data.linkedin.startsWith('http')
                                ? person.data.linkedin
                                : `https://${person.data.linkedin}`
                            }
                            target='_blank'
                            rel='noopener noreferrer'
                            class='text-foreground/80 hover:text-foreground hover:border-foreground/80 inline-flex size-8 items-center justify-center rounded-lg border-transparent transition-colors hover:border-2'
                            aria-label={`Open ${person.data.name} LinkedIn`}
                          >
                            <svg viewBox='0 0 24 24' fill='currentColor' class='size-6' aria-hidden='true'>
                              <path d='M6.94 8.5A1.56 1.56 0 1 1 6.94 5.4a1.56 1.56 0 0 1 0 3.1zM5.5 9.75h2.88V18H5.5V9.75zM10.1 9.75h2.76v1.12h.04c.38-.72 1.33-1.48 2.74-1.48 2.93 0 3.47 1.93 3.47 4.44V18h-2.88v-3.7c0-.88-.02-2.01-1.22-2.01-1.22 0-1.4.95-1.4 1.95V18H10.1V9.75z' />
                            </svg>
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                </div>

                <a href={withBasePath(`/about-us/team/${person.id}`)} class='block'>
                  <p class='text-muted-foreground text-sm'>{person.data.bio}</p>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Layout>
