---
import Layout from '@/layouts/Layout.astro'
import { getCollection, render } from 'astro:content'
import { Separator } from '@/components/ui/separator'
import { Button } from '@/components/ui/button'
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator
} from '@/components/ui/breadcrumb'
import DynamicToc from '@/components/astro/DynamicToc.astro'
import { AuthorMetadata } from '@/components/AuthorAvatar'
import { getPostNavigation } from '@/utils/blog'
import { withBasePath } from '@/lib/paths'
import { ChevronLeftIcon, ChevronRightIcon } from 'lucide-react'

import Blog from '@/components/blocks/blog-related-post/blog-related-post'

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog')
  return blogEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry }
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

// Get all posts for navigation and related posts
const allPosts = await getCollection('blog')
const people = await getCollection('people')
const visiblePosts = allPosts.filter(post => post.data.visible !== false)

const peopleById = new Map(people.map(person => [person.id, person]))
const getAuthorId = (author: { id: string } | string) => (typeof author === 'string' ? author : author.id)
const getEntryAuthorIds = (post: {
  data: { author?: { id: string } | string; authors?: Array<{ id: string } | string> }
}) => {
  if (post.data.authors?.length) {
    return post.data.authors.map(getAuthorId)
  }

  return post.data.author ? [getAuthorId(post.data.author)] : []
}

const getCategories = (post: { data: { category?: string; categories?: string[] } }): string[] => {
  if (post.data.categories?.length) return post.data.categories
  if (post.data.category) return [post.data.category]
  return ['General']
}

const entryAuthorIds = getEntryAuthorIds(entry)
const entryAuthorPeople = entryAuthorIds
  .map(authorId => peopleById.get(authorId))
  .filter((person): person is (typeof people)[number] => Boolean(person))
const authorNameList = entryAuthorPeople.map(person => person.data.name)
const authorName = authorNameList.length > 0 ? authorNameList.join(', ') : 'Unknown Author'
const entryCategories = getCategories(entry)

// Related posts are only shown when explicitly listed in frontmatter.
const relatedReferenceIds = entry.data.relatedPosts ?? []
const relatedPosts =
  relatedReferenceIds.length > 0
    ? relatedReferenceIds
        .map(referenceId => visiblePosts.find(post => post.id === referenceId || post.data.slug === referenceId))
        .filter((post): post is (typeof visiblePosts)[number] => post !== undefined)
        .filter(post => post.id !== entry.id)
        .filter((post, index, posts) => posts.findIndex(candidate => candidate.id === post.id) === index)
    : []

// Map relatedPosts to BlogPost type for the Blog component
const formattedRelatedPosts = relatedPosts.map(post => {
  const authorIds = getEntryAuthorIds(post)
  const authorPeople = authorIds
    .map(authorId => peopleById.get(authorId))
    .filter((person): person is (typeof people)[number] => Boolean(person))
  const authorNames = authorPeople.map(person => person.data.name)
  const primaryAuthorId = authorIds[0]
  const primaryAuthor = primaryAuthorId ? peopleById.get(primaryAuthorId) : undefined
  const categories = getCategories(post)

  return {
    id: post.data.id,
    slug: post.data.slug,
    title: post.data.title,
    description: post.data.description,
    imageUrl: post.data.imageUrl || '',
    imageAlt: post.data.imageAlt || '',
    pubDate: post.data.pubDate,
    author: authorNames.length > 0 ? authorNames.join(', ') : 'Unknown Author',
    avatarFullUrl:
      primaryAuthor?.data.avatarFullUrl ||
      primaryAuthor?.data.avatarTransparentUrl ||
      '/images/avatars/avatar-placeholder.jpg',
    authorUrl:
      authorIds.length === 1 && primaryAuthor?.data.type === 'team'
        ? withBasePath(`/about-us/team/${primaryAuthorId}`)
        : undefined,
    categories: categories,
    featured: post.data.featured || false
  }
})

// Get previous and next posts
const { previous: previousPost, next: nextPost } = getPostNavigation(visiblePosts, entry.id)

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  image: entry.data.imageUrl ? withBasePath(entry.data.imageUrl) : undefined,
  datePublished: entry.data.pubDate,
  author:
    authorNameList.length > 1
      ? authorNameList.map(name => ({ '@type': 'Person', name }))
      : {
          '@type': 'Person',
          name: authorName
        }
}
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.imageUrl}
  type='article'
  publishedTime={entry.data.pubDate}
  author={authorName}
  schema={schema}
>
  <main class='flex flex-col'>
    <section class='py-8 sm:pt-16 sm:pb-24'>
      <div class='mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:space-y-16 lg:px-8'>
        <div class='gap-16 md:grid md:grid-cols-5 lg:grid-cols-7'>
          <!-- Table of Contents Sidebar -->
          <div class='hidden md:col-span-2 md:block lg:col-span-2'>
            <DynamicToc headings={headings} />
          </div>

          <!-- Main Content -->
          <div class='space-y-12 md:col-span-3 lg:col-span-5'>
            <!-- Breadcrumbs -->
            <div class='space-y-6'>
              <Breadcrumb>
                <BreadcrumbList>
                  <BreadcrumbItem>
                    <BreadcrumbLink href={withBasePath('/')}>Home</BreadcrumbLink>
                  </BreadcrumbItem>
                  <BreadcrumbSeparator />
                  <BreadcrumbItem>
                    <BreadcrumbLink href={withBasePath('/blog')}>Blog</BreadcrumbLink>
                  </BreadcrumbItem>
                  <BreadcrumbSeparator />
                  <BreadcrumbItem>
                    <BreadcrumbPage>{entryCategories[0]}</BreadcrumbPage>
                  </BreadcrumbItem>
                </BreadcrumbList>
              </Breadcrumb>

              <!-- Title and Description -->
              <h1 class='text-foreground text-4xl font-semibold'>{entry.data.title}</h1>
              <p class='text-muted-foreground text-xl'>{entry.data.description}</p>

              <Separator />

              <!-- Post Metadata -->
              <div class='flex flex-wrap justify-between gap-4'>
                <div class='flex flex-col gap-1.5 md:flex-1'>
                  <span class='text-muted-foreground text-sm'>Written by</span>
                  <div class='flex flex-wrap gap-4'>
                    {
                      entryAuthorPeople.map((author, index) => {
                        const authorProfileUrl =
                          entryAuthorIds.length === 1 && author.data.type === 'team'
                            ? withBasePath(`/about-us/team/${entryAuthorIds[0]}`)
                            : author.data.type === 'team'
                              ? withBasePath(`/about-us/team/${entryAuthorIds[index]}`)
                              : undefined

                        return (
                          <div class='flex items-center gap-2'>
                            <AuthorMetadata
                              client:load
                              avatarFullUrl={
                                author.data.avatarFullUrl ||
                                author.data.avatarTransparentUrl ||
                                '/images/avatars/avatar-placeholder.jpg'
                              }
                              author={author.data.name}
                            />
                            <div class='flex flex-col gap-0.5'>
                              {authorProfileUrl ? (
                                <a class='text-foreground text-sm font-medium hover:underline' href={authorProfileUrl}>
                                  {author.data.name}
                                </a>
                              ) : (
                                <span class='text-foreground text-sm font-medium'>{author.data.name}</span>
                              )}
                            </div>
                          </div>
                        )
                      })
                    }
                  </div>
                </div>
                <div class='flex flex-col gap-1.5'>
                  <span class='text-muted-foreground text-sm'>Posted on</span>
                  <span class='text-foreground text-sm font-medium'>{entry.data.pubDate}</span>
                </div>
              </div>
            </div>

            <!-- Hero Image -->
            {
              entry.data.imageUrl && (
                <div>
                  <img
                    src={withBasePath(entry.data.imageUrl)}
                    alt={entry.data.title}
                    class='max-h-148 w-full rounded-xl'
                    loading='lazy'
                  />
                </div>
              )
            }

            <!-- Article Content -->
            <article id='content' class='prose dark:prose-invert max-w-none'>
              <Content />
            </article>

            <!-- Post Navigation -->
            <div class='flex w-full justify-between pt-8'>
              {
                previousPost ? (
                  <a href={withBasePath(`/blog/${previousPost.id}`)}>
                    <Button className='rounded-xl' variant='outline'>
                      <ChevronLeftIcon className='size-4' />
                      Previous Post
                    </Button>
                  </a>
                ) : (
                  <Button className='rounded-xl' variant='outline' disabled>
                    <ChevronLeftIcon className='size-4' />
                    Previous Post
                  </Button>
                )
              }

              {
                nextPost ? (
                  <a class='ms-auto' href={withBasePath(`/blog/${nextPost.id}`)}>
                    <Button
                      className='rounded-xl bg-sky-600/10 text-sky-600 hover:bg-sky-600/20 focus-visible:ring-sky-600/20 dark:bg-sky-400/10 dark:text-sky-400 dark:hover:bg-sky-400/20 dark:focus-visible:ring-sky-400/40'
                      variant='outline'
                    >
                      Next Post
                      <ChevronRightIcon className='size-4' />
                    </Button>
                  </a>
                ) : (
                  <Button
                    className='ml-auto rounded-xl bg-sky-600/10 text-sky-600 hover:bg-sky-600/20 focus-visible:ring-sky-600/20 dark:bg-sky-400/10 dark:text-sky-400 dark:hover:bg-sky-400/20 dark:focus-visible:ring-sky-400/40'
                    variant='outline'
                    disabled
                  >
                    Next Post
                    <ChevronRightIcon className='size-4' />
                  </Button>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    {formattedRelatedPosts.length > 0 && <Blog relatedPosts={formattedRelatedPosts} />}
  </main>
</Layout>
