---
import { withBasePath } from '@/lib/paths'

type GalleryImage = {
  src: string
  alt: string
  caption?: string
}

type Props = {
  images: GalleryImage[]
}

const { images } = Astro.props as Props
---

<div class='my-8 grid grid-cols-2 gap-4 lg:grid-cols-3'>
  {
    images.map(image => (
      <figure class='space-y-2'>
        <div class='border-border bg-card overflow-hidden rounded-2xl border shadow-sm'>
          <img
            src={withBasePath(image.src)}
            alt={image.alt}
            class='my-0 h-full w-full object-cover'
            loading='lazy'
            decoding='async'
          />
        </div>
        {image.caption && <figcaption class='text-muted-foreground text-sm leading-6'>{image.caption}</figcaption>}
      </figure>
    ))
  }
</div>
