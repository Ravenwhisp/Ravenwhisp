---
import { withBasePath } from '@/lib/paths'

type Props = {
  src: string
  alt: string
  caption?: string
  fullWidth?: boolean
  fit?: 'cover' | 'contain'
}

const { src, alt, caption, fullWidth = true, fit = 'cover' } = Astro.props as Props
const objectClass = fit === 'contain' ? 'object-contain' : 'object-cover'
---

<figure class:list={[fullWidth ? 'my-8' : 'my-6 lg:mx-auto lg:max-w-[50%]']}>
  <div class='border-border bg-card overflow-hidden rounded-2xl border shadow-sm'>
    <img
      src={withBasePath(src)}
      alt={alt}
      class:list={['h-auto w-full', objectClass]}
      loading='lazy'
      decoding='async'
    />
  </div>
  {caption && <figcaption class='text-muted-foreground mt-3 text-sm leading-6'>{caption}</figcaption>}
</figure>
